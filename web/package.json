{
  "name": "launder-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Launder browser client: TS port of the SynthID detector, the packed Gemma-3 tokenizer reader, and the preview scorer.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack-check": "node tools/pack-check.mjs",
    "size-gate": "node tools/size-gate.mjs",
    "slop-check": "node tools/slop-check.mjs",
    "parity": "node tools/parity.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^3.0.0"
  }
}
